{
  "name": "react-sweet-wizard",
  "version": "2.0.1",
  "description": "Your module to handle wizard steps in ReactJS applications easier",
  "author": "Will Mendes <willmendesneto@gmail.com> (http://github.com/willmendesneto)",
  "keywords": [
    "react",
    "reactjs",
    "wizard",
    "steps",
    "step",
    "stepper",
    "form",
    "react",
    "sweet",
    "react-sweet-wizard"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/willmendesneto/react-sweet-wizard#readme",
  "bugs": {
    "url": "https://github.com/willmendesneto/react-sweet-wizard/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willmendesneto/react-sweet-wizard.git"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "jsnext:main": "dist/esm/index.js",
  "es2015": "dist/es2015/index.js",
  "es2020": "dist/es2020/index.js",
  "cjs": "dist/cjs/index.js",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && rollup -c",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:types": "tsc --noEmit",
    "lint:types-watch": "tsc --noEmit --watch",
    "prepack": "npm run preversion -s && npm run build -s",
    "test": "jest",
    "test:watch": "jest --watch",
    "preversion": "npm run lint -s && npm run lint:types -s && npm run test -s",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md",
    "test:ci": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "size": "size-limit"
  },
  "devDependencies": {
    "@babel/cli": "^7.15.7",
    "@babel/core": "^7.15.8",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-proposal-export-namespace-from": "^7.14.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-runtime": "^7.15.8",
    "@babel/polyfill": "^7.4.4",
    "@babel/preset-env": "^7.15.8",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.4",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-typescript": "^12.3.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/react-hooks": "^7.0.2",
    "@types/jest": "^27.0.2",
    "@types/react": "^17.0.33",
    "@types/react-dom": "^17.0.10",
    "babel-jest": "^27.3.1",
    "babel-loader": "^8.2.3",
    "babel-types": "^6.26.0",
    "changelog-verify": "^1.1.2",
    "coveralls": "^3.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^27.3.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^16.10.2",
    "react-dom": "^17.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "version-changelog": "^3.1.1"
  },
  "peerDependencies": {
    "react": ">=17.0.2",
    "react-dom": ">=17.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "last 1 chrome versions",
    "last 1 edge versions",
    "last 1 firefox versions",
    "last 1 safari versions",
    "last 1 and_chr versions",
    "last 1 ios_saf versions",
    "ie 11"
  ]
}
