{
  "name": "react-sweet-wizard",
  "version": "2.0.1",
  "description": "Your module to handle wizard steps in ReactJS applications easier",
  "author": "Will Mendes <willmendesneto@gmail.com> (http://github.com/willmendesneto)",
  "keywords": [
    "react",
    "reactjs",
    "wizard",
    "steps",
    "step",
    "stepper",
    "form",
    "react",
    "sweet",
    "react-sweet-wizard"
  ],
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/willmendesneto/react-sweet-wizard#readme",
  "bugs": {
    "url": "https://github.com/willmendesneto/react-sweet-wizard/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/willmendesneto/react-sweet-wizard.git"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && rollup -c",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:types": "tsc --noEmit",
    "prepack": "npm run preversion -s && npm run build -s",
    "test": "vitest run",
    "test:watch": "vitest",
    "preversion": "npm run lint -s && npm run lint:types -s && npm run test -s",
    "version": "version-changelog CHANGELOG.md && changelog-verify CHANGELOG.md && git add CHANGELOG.md",
    "size": "size-limit",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-typescript": "^12.3.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "~1.5.4",
    "changelog-verify": "^1.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "size-limit": "^14.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "version-changelog": "^3.1.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "last 1 chrome versions",
    "last 1 edge versions",
    "last 1 firefox versions",
    "last 1 safari versions",
    "last 1 and_chr versions",
    "last 1 ios_saf versions",
    "ie 11"
  ]
}
