{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "noUnusedLocals": false,
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": false,
    "removeComments": true
  },
  "exclude": [
    "examples/**/*",
    "**/__tests__/**/*",
    "**/*.test.tsx",
    "**/*.test.ts"
  ]
}
