{
  "extends": "./tsconfig.json",
  "include": [
    "src"
  ],
  "noUnusedLocals": false,
  "compilerOptions": {
    "esModuleInterop": false,
    "removeComments": true,
    "target": "ES2019"
  },
  "exclude": [
    "examples/**/*",
    "**/__tests__/**/*",
    "**/*.test.tsx",
    "**/*.test.ts"
  ]
}
